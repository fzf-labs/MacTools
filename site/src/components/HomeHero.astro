---
import { loadPluginCatalog, localizedPluginText, type Plugin } from "@/lib/plugins";

interface Props {
  downloadURL: string;
}

const { downloadURL } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;

const installCommand = "brew install --cask mactools";
const sparkBars = Array.from({ length: 14 });
const catalog = await loadPluginCatalog();
const pluginsByID = new Map(catalog.plugins.map((plugin) => [plugin.id, plugin]));

type InteractionType = "disclosure" | "switch" | "button";
type LocalizedLabel = { zh: string; en: string };
type DetailListOption = LocalizedLabel & {
  id: string;
  mode: "action" | "switch" | "select" | "navigation";
  symbol?: string;
  subtitle?: LocalizedLabel;
  selected?: boolean;
  enabled?: boolean;
  divider?: boolean;
};
type DetailModel = {
  label?: LocalizedLabel;
  minimum?: number;
  maximum?: number;
  value?: number;
  unit?: string;
  options?: DetailListOption[];
};

const interactionGroups: Array<{ type: InteractionType; ids: string[] }> = [
  {
    type: "disclosure",
    ids: [
      "display-brightness",
      "display-resolution",
      "sidecar",
      "disk-clean",
      "xcode-clean",
