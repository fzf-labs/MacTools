                    <path class="sim-chart-line sim-chart-download" data-sim-chart-line="network-download" d="M0 17 L10 14 L20 16 L30 9 L40 12 L50 5 L60 11 L70 8 L80 13 L90 4 L100 7 L110 3 L120 8"></path>
                    <path class="sim-chart-area sim-chart-upload" data-sim-chart-area="network-upload" d="M0 22 L0 19 L10 18 L20 20 L30 15 L40 17 L50 12 L60 16 L70 14 L80 18 L90 11 L100 16 L110 13 L120 17 L120 22 Z"></path>
                    <path class="sim-chart-line sim-chart-upload" data-sim-chart-line="network-upload" d="M0 19 L10 18 L20 20 L30 15 L40 17 L50 12 L60 16 L70 14 L80 18 L90 11 L100 16 L110 13 L120 17"></path>
                  </svg>
                  <footer class="sim-rate-footer"><span class="sim-download">↓ <b data-sim-down>3.7 MB/s</b></span><span class="sim-upload">↑ <b data-sim-up>1.1 MB/s</b></span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-disk" data-sim-metric="disk">
