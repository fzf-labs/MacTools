                    <path class="sim-chart-line sim-chart-battery" data-sim-chart-line="battery" d="M0 5 L10 6 L20 6 L30 7 L40 8 L50 8 L60 9 L70 10 L80 11 L90 12 L100 13 L110 14 L120 15"></path>
                  </svg>
                  <footer><span data-sim-footnote><span data-i18n-zh>健康 96% · 182 次循环</span><span data-i18n-en>96% health · 182 cycles</span></span></footer>
                </section>
              </div>

              <section class="sim-process-card">
                <header><strong><span data-i18n-zh>进程</span><span data-i18n-en>Processes</span></strong><span>CPU&nbsp;&nbsp;&nbsp;MEM</span></header>
                <div class="sim-process-list">
                  <div><span><i class="sim-process-dot process-blue"></i>MacTools</span><span><b data-sim-process-cpu="0">7.2%</b><b>1.1%</b></span></div>
                  <div><span><i class="sim-process-dot process-pink"></i>WindowServer</span><span><b data-sim-process-cpu="1">5.8%</b><b>3.4%</b></span></div>
                  <div><span><i class="sim-process-dot process-green"></i>Safari</span><span><b data-sim-process-cpu="2">3.1%</b><b>4.8%</b></span></div>
                </div>
              </section>
            </article>

            <article
              class="sim-dashboard-widget sim-device-widget"
              aria-label={dashboardPlugins["device-battery"]?.text.zh.displayName ?? "设备电量"}
              data-aria-zh={dashboardPlugins["device-battery"]?.text.zh.displayName ?? "设备电量"}
              data-aria-en={dashboardPlugins["device-battery"]?.text.en.displayName ?? "Device Battery"}
              title={dashboardPlugins["device-battery"]?.text.zh.summary}
              data-title-zh={dashboardPlugins["device-battery"]?.text.zh.summary}
              data-title-en={dashboardPlugins["device-battery"]?.text.en.summary}
            >
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("laptopcomputer")}></i>
                </span>
                <strong>MacBook Pro</strong>
                <b data-sim-device-level="mac">84%</b>
                <span class="sim-device-battery"><i data-sim-device-bar="mac"></i></span>
              </div>
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("iphone")}></i>
                </span>
                <strong>iPhone</strong>
                <b>29%</b>
                <span class="sim-device-battery"><i class="is-low" style="width: 29%"></i></span>
              </div>
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("airpods.chargingcase")}></i>
                </span>
                <strong><span data-i18n-zh>AirPods 充电盒</span><span data-i18n-en>AirPods Case</span></strong>
                <b>87%</b>
                <span class="sim-device-battery"><i style="width: 87%"></i></span>
              </div>
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("airpod.right")}></i>
                </span>
                <strong><span data-i18n-zh>右耳 AirPod</span><span data-i18n-en>Right AirPod</span></strong>
                <b>100%</b>
                <span class="sim-device-battery"><i style="width: 100%"></i></span>
              </div>
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("airpod.left")}></i>
                </span>
                <strong><span data-i18n-zh>左耳 AirPod</span><span data-i18n-en>Left AirPod</span></strong>
                <b>100%</b>
                <span class="sim-device-battery"><i style="width: 100%"></i></span>
              </div>
              <div class="sim-device-row">
                <span class="sim-device-icon" aria-hidden="true">
                  <i class="sim-sf-symbol" style={symbolStyle("computermouse.fill")}></i>
                </span>
                <strong>MX Anywhere 3S</strong>
                <b>55%</b>
                <span class="sim-device-battery"><i style="width: 55%"></i></span>
              </div>
            </article>

            <article
              class="sim-dashboard-widget sim-activity-widget"
              aria-label={dashboardPlugins["activity-bar"]?.text.zh.displayName ?? "活动统计"}
              data-aria-zh={dashboardPlugins["activity-bar"]?.text.zh.displayName ?? "活动统计"}
              data-aria-en={dashboardPlugins["activity-bar"]?.text.en.displayName ?? "Activity Stats"}
              title={dashboardPlugins["activity-bar"]?.text.zh.summary}
              data-title-zh={dashboardPlugins["activity-bar"]?.text.zh.summary}
              data-title-en={dashboardPlugins["activity-bar"]?.text.en.summary}
            >
              <header class="sim-activity-header">
                <strong>
                  <span data-i18n-zh>{dashboardPlugins["activity-bar"]?.text.zh.displayName ?? "活动统计"}</span>
                  <span data-i18n-en>{dashboardPlugins["activity-bar"]?.text.en.displayName ?? "Activity Stats"}</span>
                </strong>
                <div>
                  <button
                    type="button"
                    data-sim-activity-day="-1"
                    aria-label="前一天"
                    data-aria-zh="前一天"
                    data-aria-en="Previous day"
                  ><span class="sim-sf-symbol" style={symbolStyle("chevron.left")} aria-hidden="true"></span></button>
                  <span data-sim-activity-date><span data-i18n-zh>今天</span><span data-i18n-en>Today</span></span>
                  <button
                    type="button"
                    data-sim-activity-day="1"
                    aria-label="后一天"
                    data-aria-zh="后一天"
                    data-aria-en="Next day"
                  ><span class="sim-sf-symbol" style={symbolStyle("chevron.right")} aria-hidden="true"></span></button>
                </div>
              </header>
              <div class="sim-activity-stats">
                <div><i class="sim-sf-symbol activity-blue" style={symbolStyle("keyboard")} aria-hidden="true"></i><span><b data-sim-activity-keys>8,426</b><small><span data-i18n-zh>按键</span><span data-i18n-en>Keystrokes</span></small></span></div>
                <div><i class="sim-sf-symbol activity-pink" style={symbolStyle("cursorarrow.click.2")} aria-hidden="true"></i><span><b data-sim-activity-clicks>2,184</b><small><span data-i18n-zh>点击</span><span data-i18n-en>Clicks</span></small></span></div>
                <div><i class="sim-sf-symbol activity-green" style={symbolStyle("scroll")} aria-hidden="true"></i><span><b data-sim-activity-scrolls>1,079</b><small><span data-i18n-zh>滚动</span><span data-i18n-en>Scrolls</span></small></span></div>
                <div><i class="sim-sf-symbol activity-orange" style={symbolStyle("macwindow.on.rectangle")} aria-hidden="true"></i><span><b data-sim-activity-time>4h 36m</b><small><span data-i18n-zh>屏幕时间</span><span data-i18n-en>Screen Time</span></small></span></div>
              </div>
              <div class="sim-activity-chart" aria-hidden="true">
                {sparkBars.map((_, index) => <i style={`height: ${28 + ((index * 23) % 62)}%`}></i>)}
              </div>
            </article>

            <article
              class="sim-dashboard-widget sim-calendar-widget"
              aria-label={dashboardPlugins["calendar"]?.text.zh.displayName ?? "日历"}
              data-aria-zh={dashboardPlugins["calendar"]?.text.zh.displayName ?? "日历"}
              data-aria-en={dashboardPlugins["calendar"]?.text.en.displayName ?? "Calendar"}
              title={dashboardPlugins["calendar"]?.text.zh.summary}
              data-title-zh={dashboardPlugins["calendar"]?.text.zh.summary}
              data-title-en={dashboardPlugins["calendar"]?.text.en.summary}
            >
              <header class="sim-calendar-header">
                <strong>
                  <span data-i18n-zh data-sim-calendar-title-zh>{calendarTitleZh}</span>
                  <span data-i18n-en data-sim-calendar-title-en>{calendarTitleEn}</span>
                </strong>
                <div>
                  <button
                    type="button"
                    data-sim-calendar-nav="previous"
                    aria-label="上个月"
                    data-aria-zh="上个月"
                    data-aria-en="Previous month"
                  ><span class="sim-sf-symbol" style={symbolStyle("chevron.left")} aria-hidden="true"></span></button>
                  <button type="button" data-sim-calendar-nav="today"><span data-i18n-zh>今天</span><span data-i18n-en>Today</span></button>
                  <button
                    type="button"
                    data-sim-calendar-nav="next"
                    aria-label="下个月"
                    data-aria-zh="下个月"
                    data-aria-en="Next month"
                  ><span class="sim-sf-symbol" style={symbolStyle("chevron.right")} aria-hidden="true"></span></button>
                </div>
              </header>
              <div class="sim-calendar-weekdays" aria-hidden="true">
                {[
                  { zh: "一", en: "M" },
                  { zh: "二", en: "T" },
                  { zh: "三", en: "W" },
                  { zh: "四", en: "T" },
                  { zh: "五", en: "F" },
                  { zh: "六", en: "S" },
                  { zh: "日", en: "S" },
                ].map((weekday) => (
                  <span><i data-i18n-zh>{weekday.zh}</i><i data-i18n-en>{weekday.en}</i></span>
                ))}
              </div>
              <div class="sim-calendar-grid">
                {calendarCells.map((cell) => (
                  <button
                    type="button"
                    class:list={{
                      "is-outside": !cell.isCurrentMonth,
                      "is-today": cell.isToday,
                      "has-events": cell.isCurrentMonth && [1, 8, 12, 18, 24].includes(cell.day),
                    }}
                    data-sim-calendar-cell
                    data-sim-calendar-day={cell.day}
                    aria-label={`${cell.date.getFullYear()}-${cell.date.getMonth() + 1}-${cell.day}`}
                  >
                    <b>{cell.day}</b>
                    <small>
                      <span data-i18n-zh>{cell.isToday ? "今天" : cell.lunarLabel}</span>
                      <span data-i18n-en>{cell.isToday ? "Today" : cell.dayCode}</span>
                    </small>
                    <span class="sim-calendar-event-dots" aria-hidden="true"></span>
                  </button>
                ))}
              </div>
            </article>
          </div>
        </div>

        <div
          class="sim-panel-view sim-controls-view"
          id="sim-controls-panel"
          role="tabpanel"
          aria-labelledby="sim-controls-tab"
          hidden
          data-sim-view="controls"
        >
          <div class="sim-feature-list">
            {panelEntries.map(({ plugin, text, type }) => {
              const symbol = pluginSymbols[plugin.id] ?? "app.dashed";
              const detail = disclosureDetails[plugin.id];
              const actionLabel = actionLabels[plugin.id] ?? { zh: "操作", en: "Run" };
              const isEnabled = defaultEnabled.has(plugin.id);
              const rowContent = (
                <>
                  <span class="sim-feature-icon" aria-hidden="true">
                    <i class="sim-sf-symbol" style={symbolStyle(symbol)}></i>
                  </span>
                  <span class="sim-feature-copy">
                    <strong><span data-i18n-zh>{text.zh.displayName}</span><span data-i18n-en>{text.en.displayName}</span></strong>
                    <small><span data-i18n-zh>{text.zh.summary}</span><span data-i18n-en>{text.en.summary}</span></small>
                  </span>
                </>
              );

              return (
                <article class={`sim-feature-item sim-feature-${type}`} data-sim-plugin={plugin.id}>
                  {type === "disclosure" ? (
                    <>
                      <button
                        class="sim-feature-row"
                        type="button"
                        data-sim-disclosure
                        aria-expanded="false"
                        aria-label={text.zh.displayName}
                        data-aria-zh={text.zh.displayName}
                        data-aria-en={text.en.displayName}
                      >
                        {rowContent}
                        <span class="sim-disclosure-chevron" aria-hidden="true">
                          <i class="sim-sf-symbol sim-chevron-right" style={symbolStyle("chevron.right")}></i>
                          <i class="sim-sf-symbol sim-chevron-down" style={symbolStyle("chevron.down")}></i>
                        </span>
                      </button>
                      {detail ? (
                        <div class="sim-feature-detail" data-sim-disclosure-detail hidden>
                          {detail.label && detail.value === undefined ? (
                            <div class="sim-detail-section-title">
                              <span data-i18n-zh>{detail.label.zh}</span>
                              <span data-i18n-en>{detail.label.en}</span>
                            </div>
                          ) : null}
                          {detail.label && detail.value !== undefined ? (
                            <>
                              <div class="sim-detail-heading">
                                <span><span data-i18n-zh>{detail.label.zh}</span><span data-i18n-en>{detail.label.en}</span></span>
                                <b data-sim-range-value>{detail.value}{detail.unit}</b>
                              </div>
                              <input
                                type="range"
                                min={detail.minimum}
                                max={detail.maximum}
                                value={detail.value}
                                data-sim-range
                                data-sim-range-unit={detail.unit}
                                aria-label={detail.label.zh}
                                data-aria-zh={detail.label.zh}
                                data-aria-en={detail.label.en}
                              />
                            </>
                          ) : null}
                          {detail.options?.length ? (
                            <div class="sim-detail-list">
                              {detail.options.map((option) => {
                                const enabled = option.enabled !== false;
                                return (
                                  <>
                                    {option.divider ? <div class="sim-detail-divider" aria-hidden="true"></div> : null}
                                    {option.mode === "switch" ? (
                                      <div class="sim-detail-list-row is-switch-row">
                                        {option.symbol ? <i class="sim-sf-symbol sim-detail-row-icon" style={symbolStyle(option.symbol)} aria-hidden="true"></i> : null}
                                        <span class="sim-detail-row-copy">
                                          <strong><span data-i18n-zh>{option.zh}</span><span data-i18n-en>{option.en}</span></strong>
                                        </span>
                                        <button
                                          class:list={["sim-toggle", { "is-on": option.selected }]}
                                          type="button"
                                          role="switch"
                                          aria-checked={option.selected ? "true" : "false"}
                                          data-sim-detail-switch
                                        ><i></i></button>
                                      </div>
                                    ) : (
                                      <button
                                        class:list={[
                                          "sim-detail-list-row",
                                          `is-${option.mode}-row`,
                                          { "is-selected": option.selected },
                                        ]}
                                        type="button"
                                        disabled={!enabled}
                                        aria-pressed={option.selected ? "true" : "false"}
                                        data-sim-detail-option
                                        data-sim-detail-mode={option.mode}
                                        data-sim-secondary-target={plugin.id === "display-resolution" && option.id === "builtin-display" ? "display-resolution" : undefined}
                                      >
                                        {option.mode === "select" ? (
                                          <span class="sim-selection-mark" aria-hidden="true">
                                            <i class="sim-sf-symbol" style={symbolStyle("checkmark")}></i>
                                          </span>
                                        ) : option.symbol ? (
                                          <i class="sim-sf-symbol sim-detail-row-icon" style={symbolStyle(option.symbol)} aria-hidden="true"></i>
                                        ) : null}
                                        <span class="sim-detail-row-copy">
                                          <strong><span data-i18n-zh>{option.zh}</span><span data-i18n-en>{option.en}</span></strong>
                                          {option.subtitle ? <small><span data-i18n-zh>{option.subtitle.zh}</span><span data-i18n-en>{option.subtitle.en}</span></small> : null}
                                        </span>
                                        {option.mode === "navigation" ? (
                                          <i class="sim-sf-symbol sim-detail-row-chevron" style={symbolStyle("chevron.right")} aria-hidden="true"></i>
                                        ) : null}
                                      </button>
                                    )}
                                  </>
                                );
                              })}
                            </div>
                          ) : null}
                        </div>
                      ) : null}
                    </>
                  ) : (
                    <div class="sim-feature-row">
                      {rowContent}
                      {type === "switch" ? (
                        <button
                          class:list={["sim-toggle", { "is-on": isEnabled }]}
                          type="button"
                          role="switch"
                          aria-checked={isEnabled ? "true" : "false"}
                          aria-label={text.zh.displayName}
                          data-aria-zh={text.zh.displayName}
                          data-aria-en={text.en.displayName}
                          data-sim-setting={plugin.id}
                        ><i></i></button>
                      ) : (
                        <button
                          class="sim-control-action"
                          type="button"
                          data-sim-action
                          data-plugin-name-zh={text.zh.displayName}
                          data-plugin-name-en={text.en.displayName}
                          data-action-zh={actionLabel.zh}
                          data-action-en={actionLabel.en}
                        >
                          <span data-i18n-zh>{actionLabel.zh}</span><span data-i18n-en>{actionLabel.en}</span>
                        </button>
                      )}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>

        <div class="sim-toast" role="status" aria-live="polite" data-sim-toast></div>
      </section>

      <div
        class="sim-resolution-secondary-panel"
        role="menu"
        aria-label="内建显示器"
        data-aria-zh="内建显示器"
        data-aria-en="Built-in Display"
        data-sim-resolution-panel
        data-side="right"
        hidden
      >
        <header>
          <strong><span data-i18n-zh>内建显示器</span><span data-i18n-en>Built-in Display</span></strong>
        </header>
        <div class="sim-resolution-list">
          {simulatedDisplayResolutions.map((resolution) => (
            <button
              class:list={{ "is-selected": resolution.selected }}
              type="button"
              role="menuitemradio"
              aria-checked={resolution.selected ? "true" : "false"}
              data-sim-resolution-option
              data-sim-resolution-value={resolution.id}
            >
              <span class="sim-resolution-check" aria-hidden="true">
                <i class="sim-sf-symbol" style={symbolStyle("checkmark")}></i>
              </span>
              <span data-i18n-zh>{resolution.zh}</span>
              <span data-i18n-en>{resolution.en}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="sim-calendar-popover" role="tooltip" data-sim-calendar-popover hidden>
        <div class="sim-calendar-popover-notch" aria-hidden="true"></div>
        <div class="sim-calendar-popover-heading">
          <strong data-sim-calendar-popover-title></strong>
          <small data-sim-calendar-popover-subtitle></small>
        </div>
        <div class="sim-calendar-popover-divider" aria-hidden="true"></div>
        <div class="sim-calendar-popover-events" data-sim-calendar-popover-events></div>
      </div>
    </div>
  </div>
</section>
