                  <div class="sim-hud-reading"><b data-sim-value>41.0</b><small>GB <span data-i18n-zh>可用</span><span data-i18n-en>free</span></small></div>
                  <svg class="sim-hud-chart" viewBox="0 0 120 22" preserveAspectRatio="none" aria-hidden="true">
