const simulatedDisplayResolutions = [
  { id: "5120x2880", zh: "5120×2880 (LoDPI)", en: "5120×2880 (LoDPI)" },
  { id: "4096x2304", zh: "4096×2304 (LoDPI)", en: "4096×2304 (LoDPI)" },
  { id: "3200x1800", zh: "3200×1800 (HiDPI)", en: "3200×1800 (HiDPI)" },
  { id: "3008x1692", zh: "3008×1692 (原生)", en: "3008×1692 (Native)" },
  { id: "2560x1440", zh: "2560×1440 (默认)", en: "2560×1440 (Default)", selected: true },
  { id: "2048x1152", zh: "2048×1152 (HiDPI)", en: "2048×1152 (HiDPI)" },
  { id: "1920x1080", zh: "1920×1080 (HiDPI)", en: "1920×1080 (HiDPI)" },
];

const defaultEnabled = new Set([
  "appearance",
  "display-true-color",
  "keep-awake",
  "app-hotkey",
]);

const panelEntries = interactionGroups.flatMap(({ type, ids }) =>
  ids.flatMap((id) => {
    const plugin = pluginsByID.get(id);
    if (!plugin) return [];
    return [{ plugin, text: localizedPluginText(plugin), type }];
  })
);

const dashboardIDs = ["system-status", "device-battery", "activity-bar", "calendar"] as const;
const dashboardPlugins = Object.fromEntries(
  dashboardIDs.flatMap((id) => {
    const plugin = pluginsByID.get(id);
    return plugin ? [[id, { plugin, text: localizedPluginText(plugin) }]] : [];
  })
) as Record<string, { plugin: Plugin; text: ReturnType<typeof localizedPluginText> }>;

const now = new Date();
const calendarYear = now.getFullYear();
const calendarMonth = now.getMonth();
const mondayFirstOffset = (new Date(calendarYear, calendarMonth, 1).getDay() + 6) % 7;
const lunarDayLabels = [
  "初一", "初二", "初三", "初四", "初五", "初六", "初七", "初八", "初九", "初十",
  "十一", "十二", "十三", "十四", "十五", "十六", "十七", "十八", "十九", "二十",
  "廿一", "廿二", "廿三", "廿四", "廿五", "廿六", "廿七", "廿八", "廿九", "三十",
];
const calendarCells = Array.from({ length: 42 }, (_, index) => {
  const date = new Date(calendarYear, calendarMonth, index - mondayFirstOffset + 1);
  const day = date.getDate();
  const isCurrentMonth = date.getMonth() === calendarMonth;
  const isToday = date.toDateString() === now.toDateString();
  return {
    date,
    day,
    isCurrentMonth,
    isToday,
    lunarLabel: lunarDayLabels[(day + 8) % lunarDayLabels.length],
    dayCode: `D${((day + 14) % 30) + 1}`,
  };
});
const calendarTitleZh = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long" }).format(now);
const calendarTitleEn = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long" }).format(now);
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero-copy">
    <div class="hero-lockup">
      <img src={withBase("/assets/logo-mactools-rounded.png")} width="72" height="72" alt="" />
      <p class="eyebrow">
        <span data-i18n-zh>原生 macOS 菜单栏工具集</span>
        <span data-i18n-en>Native macOS menu bar toolkit</span>
      </p>
    </div>
    <h1 id="home-title">
      <span class="hero-title-zh" data-i18n-zh>
        <span>常用系统操作，</span>
        <span>安静地留在菜单栏。</span>
      </span>
      <span data-i18n-en>Everyday system controls, kept quietly in the menu bar.</span>
    </h1>
    <p class="hero-lead">
      <span data-i18n-zh>MacTools 把显示器、清理、休眠、启动台、插件市场和更多高频动作集中到一个轻量入口。</span>
      <span data-i18n-en>MacTools collects display controls, cleanup, sleep, Launchpad, plugins, and other frequent actions in one lightweight native app.</span>
    </p>
    <div class="hero-actions">
      <a class="button primary" href={downloadURL} target="_blank" rel="noopener noreferrer">
        <span data-i18n-zh>立即下载</span>
        <span data-i18n-en>Download MacTools</span>
      </a>
      <a class="button subtle" href="https://github.com/ggbond268/MacTools/releases" target="_blank" rel="noopener noreferrer">
        <span data-i18n-zh>更新记录</span>
        <span data-i18n-en>What's new</span>
      </a>
    </div>
    <div class="homebrew-panel" id="install">
      <p>
        <span data-i18n-zh>也可以使用 Homebrew 安装</span>
        <span data-i18n-en>Or install with Homebrew</span>
      </p>
      <div class="command-line">
        <span>$</span>
        <code>{installCommand}</code>
        <button type="button" data-copy={installCommand}>
          <span data-i18n-zh>复制</span>
          <span data-i18n-en>Copy</span>
        </button>
      </div>
    </div>
  </div>

  <div class="hero-product">
    <div class="menu-panel-showcase" data-menubar-simulator data-preview-theme="light">
      <section
        class="sim-panel"
        id="hero-mactools-panel"
        aria-label="MacTools 模拟面板"
        data-aria-zh="MacTools 模拟面板"
        data-aria-en="MacTools simulated panel"
      >
        <div class="sim-panel-notch" aria-hidden="true"></div>
        <div class="sim-panel-toolbar">
          <div class="sim-panel-tabs" role="tablist">
            <button
              class="sim-panel-tab is-selected"
              type="button"
              role="tab"
              id="sim-monitor-tab"
              aria-controls="sim-monitor-panel"
              aria-selected="true"
              aria-label="组件面板"
              data-aria-zh="组件面板"
              data-aria-en="Components"
              data-sim-tab="monitor"
            >
              <span class="sim-sf-symbol sim-tab-symbol" style={symbolStyle("square.grid.2x2")} aria-hidden="true"></span>
              <span class="sim-tooltip" aria-hidden="true">
                <span data-i18n-zh>组件面板</span>
                <span data-i18n-en>Components</span>
              </span>
            </button>
            <button
              class="sim-panel-tab"
              type="button"
              role="tab"
              id="sim-controls-tab"
              aria-controls="sim-controls-panel"
              aria-selected="false"
              aria-label="功能面板"
              data-aria-zh="功能面板"
              data-aria-en="Controls"
              data-sim-tab="controls"
            >
              <span class="sim-sf-symbol sim-tab-symbol" style={symbolStyle("switch.2")} aria-hidden="true"></span>
              <span class="sim-tooltip" aria-hidden="true">
                <span data-i18n-zh>功能面板</span>
                <span data-i18n-en>Controls</span>
              </span>
            </button>
          </div>
        </div>

        <div
          class="sim-panel-view sim-monitor-view is-visible"
          id="sim-monitor-panel"
          role="tabpanel"
          aria-labelledby="sim-monitor-tab"
          data-sim-view="monitor"
        >
          <div class="sim-dashboard-stack">
            <article
              class="sim-dashboard-widget sim-system-widget"
              aria-label={dashboardPlugins["system-status"]?.text.zh.displayName ?? "系统状态"}
              data-aria-zh={dashboardPlugins["system-status"]?.text.zh.displayName ?? "系统状态"}
              data-aria-en={dashboardPlugins["system-status"]?.text.en.displayName ?? "System Status"}
              title={dashboardPlugins["system-status"]?.text.zh.summary}
              data-title-zh={dashboardPlugins["system-status"]?.text.zh.summary}
              data-title-en={dashboardPlugins["system-status"]?.text.en.summary}
