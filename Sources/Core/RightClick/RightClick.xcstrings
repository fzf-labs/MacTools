    "Allow MacTools to control iTerm2 in System Settings > Privacy & Security > Automation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools to control iTerm2 in System Settings > Privacy & Security > Automation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools بالتحكم في iTerm2 في إعدادات النظام > الخصوصية والأمان > الأتمتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MacTools, iTerm2 in Systemeinstellungen > Datenschutz und Sicherheit > Automatisierung zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que MacTools controle iTerm2 en Configuración del sistema > Privacidad y seguridad > Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools à contrôler iTerm2 dans Paramètres système > Confidentialité et sécurité > Automatisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[システム設定] > [プライバシーとセキュリティ] > [オートメーション] で、MacTools が iTerm2 を制御できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인 정보 보호 및 보안 > 자동화에서 MacTools가 iTerm2를 제어하도록 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o MacTools controle o iTerm2 em Configurações do sistema > Privacidade e segurança > Automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools to control iTerm2 in System Settings > Privacy & Security > Automation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Otomasyon bölümünde MacTools'un iTerm2'yi kontrol etmesine izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 > 隐私与安全性 > 自动化”中允许 MacTools 控制 iTerm2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 > 隱私權與安全性 > 自動化」中允許 MacTools 控制 iTerm2。"
          }
        }
      }
    },
    "Another file operation is in progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another file operation is in progress."
          }
        },
        "ar": {
