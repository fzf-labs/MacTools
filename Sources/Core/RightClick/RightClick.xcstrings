{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "A folder cannot be placed inside itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder cannot be placed inside itself."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن وضع مجلد داخل نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner kann nicht in sich selbst platziert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta no se puede colocar dentro de sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier ne peut pas être placé à l'intérieur de lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーをそれ自体の中に置くことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 폴더 자체 안에 들어갈 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta não pode ser colocada dentro de si mesma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка не может быть размещена внутри себя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör kendi içine yerleştirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能将文件夹放入自身或其子文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能將資料夾放入自身或其子資料夾。"
          }
        }
      }
    },
