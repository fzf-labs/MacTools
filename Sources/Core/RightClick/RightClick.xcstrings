          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação de arquivo está em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется другая файловая операция."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir dosya işlemi devam ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个文件操作正在进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个文件操作正在进行。"
          }
        }
