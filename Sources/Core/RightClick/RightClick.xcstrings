    "Imported files are copied into managed storage. Office documents require a valid template.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported files are copied into managed storage. Office documents require a valid template."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسخ الملفات المستوردة إلى وحدة التخزين المُدارة. تتطلب مستندات Office قالبًا صالحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Dateien werden in den verwalteten Speicher kopiert. Für Office-Dokumente ist eine gültige Vorlage erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos importados se copian en un almacenamiento administrado. Los documentos de Office requieren una plantilla válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers importés sont copiés dans le stockage géré. Les documents Office nécessitent un modèle valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートされたファイルは管理ストレージにコピーされます。 Office ドキュメントには有効なテンプレートが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 파일은 관리형 스토리지에 복사됩니다. Office 문서에는 유효한 템플릿이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos importados são copiados para o armazenamento gerenciado. Os documentos do Office exigem um modelo válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные файлы копируются в управляемое хранилище. Для документов Office требуется действительный шаблон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan dosyalar yönetilen depolama alanına kopyalanır. Office belgeleri geçerli bir şablon gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的文件会复制到本地资源目录。Office 文档需使用有效模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的檔案將複製到託管儲存中。 Office 文件需要有效的範本。"
          }
        }
      }
    },
