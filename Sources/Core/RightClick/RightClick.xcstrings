    "Copied, but could not remove the source. Both copies were kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied, but could not remove the source. Both copies were kept."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ، ولكن لا يمكن إزالة المصدر. تم الاحتفاظ بالنسختين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert, aber die Quelle konnte nicht entfernt werden. Beide Exemplare wurden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado, pero no se pudo eliminar la fuente. Se conservaron ambas copias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié, mais impossible de supprimer la source. Les deux exemplaires ont été conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーされましたが、ソースを削除できませんでした。両方のコピーが保管されていました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사했지만 소스를 삭제할 수 없습니다. 두 사본 모두 보관되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado, mas não foi possível remover a fonte. Ambas as cópias foram mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировал, но не смог удалить источник. Оба экземпляра сохранились."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalandı ancak kaynak kaldırılamadı. Her iki nüsha da saklandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制已完成，但无法移除源文件，两个副本均已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製已完成，但無法移除來源文件，兩個副本均已保留。"
          }
        }
      }
    },
