            "value": "MacTools считывает события календаря, чтобы отобразить ваше расписание в компоненте календаря."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools, takvim bileşeninde programınızı göstermek için takvim etkinliklerini okur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取系统日历事件，用于在右键日历组件中显示当天日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取系統日曆事件，用於在右鍵日曆組件中顯示當天行程。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records your narration only when microphone recording is enabled and saves it in the movie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在开启麦克风录制时收录讲解，并保存到录像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在開啟麥克風錄製時收錄講解，並儲存到影片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل شرحك فقط عند تمكين تسجيل الميكروفون ويحفظه في الفيديو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt deinen Kommentar nur bei aktivierter Mikrofonaufnahme auf und speichert ihn im Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba tu narración solo al activar el micrófono y la guarda en el vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre commentaire uniquement lorsque le micro est activé et le sauvegarde dans la vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク収録をオンにしたときだけ解説を収録し、動画に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 녹음을 켰을 때만 설명을 녹음하여 동영상에 저장합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava a narração apenas quando o microfone está ativado e guarda-a no vídeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает комментарий только при включённой записи микрофона и сохраняет его в видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlatımınızı yalnızca mikrofon kaydı açıkken kaydeder ve videoya ekler."
          }
        }
      }
    }
  },
  "version": "1.0"
}
