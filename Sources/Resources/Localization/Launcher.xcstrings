    "launcher.automationRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools to control Finder or System Events in System Settings > Privacy & Security > Automation, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请前往系统设置 → 隐私与安全性 → 自动化，允许 MacTools 控制访达或系统事件后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往系統設定 → 隱私權與安全性 → 自動化，允許 MacTools 控制 Finder 或系統事件後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定のプライバシーとセキュリティ → オートメーションでFinderまたはSystem Eventsの制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 MacTools의 Finder 또는 System Events 제어를 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools unter Systemeinstellungen > Datenschutz & Sicherheit > Automation die Steuerung von Finder oder System Events erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le contrôle du Finder ou de System Events dans Réglages Système > Confidentialité et sécurité > Automatisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite controlar Finder o System Events en Ajustes del Sistema > Privacidad y seguridad > Automatización."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita controlar o Finder ou System Events em Ajustes do Sistema > Privacidade e Segurança > Automação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите управление Finder или System Events в Системных настройках > Конфиденциальность и безопасность > Автоматизация."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Otomasyon bölümünde Finder veya System Events denetimine izin verin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالتحكم في Finder أو System Events في إعدادات النظام > الخصوصية والأمان > الأتمتة."
          }
        }
      }
    },
