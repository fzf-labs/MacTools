    "launcher.audioUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current audio device does not support this control. Check the device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前音频设备不支持此操作，请检查设备后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前音訊裝置不支援此操作，請檢查裝置後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のオーディオ装置はこの操作に対応していません。装置を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 오디오 기기가 이 제어를 지원하지 않습니다. 기기를 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Audiogerät unterstützt diese Steuerung nicht. Gerät prüfen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil audio ne prend pas en charge cette commande. Vérifiez-le et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de audio no admite este control. Compruébalo y reintenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo de áudio não aceita este controle. Verifique-o e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиоустройство не поддерживает эту операцию. Проверьте устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses aygıtı bu denetimi desteklemiyor. Aygıtı kontrol edip yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز الصوت الحالي لا يدعم هذا التحكم. تحقق من الجهاز وأعد المحاولة."
          }
        }
      }
    },
