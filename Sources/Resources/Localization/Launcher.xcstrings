      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to perform this system action. Check its permissions and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法执行此系统操作，请检查权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法執行此系統操作，請檢查權限後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム操作を実行できません。権限を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 작업을 실행할 수 없습니다. 권한을 확인한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaktion fehlgeschlagen. Berechtigungen prüfen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’effectuer cette action. Vérifiez les autorisations et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ejecutar la acción. Comprueba los permisos y reintenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível executar a ação. Verifique as permissões e tente novamente."
