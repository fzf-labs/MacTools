    "launcher.systemOperationsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose built-in macOS commands. Plugin features are managed separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 macOS 内置操作。插件功能在独立分类中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 macOS 內建操作。外掛功能在獨立分類中管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの内蔵コマンドを選択します。プラグイン機能は別のカテゴリで管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 기본 명령을 선택합니다. 플러그인 기능은 별도 분류에서 관리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte macOS-Befehle auswählen. Plugin-Funktionen werden separat verwaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les commandes macOS intégrées. Les fonctions des modules sont gérées séparément."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige comandos integrados de macOS. Las funciones de los complementos se gestionan aparte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha comandos integrados do macOS. As funções dos plugins são gerenciadas separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите встроенные команды macOS. Функции плагинов управляются отдельно."
          }
        },
        "tr": {
          "stringUnit": {
