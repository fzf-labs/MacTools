    "launcher.pluginFeaturesDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose feature shortcuts from enabled plugins. Plugin preferences stay in plugin settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已启用插件的功能入口，具体配置仍在插件设置中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇已啟用外掛的功能入口，具體配置仍在外掛設定中管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なプラグインの機能を選択します。詳細設定はプラグイン側で管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 플러그인의 기능을 선택하세요. 세부 설정은 플러그인 설정에서 관리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen aktivierter Plugins auswählen. Optionen bleiben in den Plugin-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les fonctions des plugins activés. Leurs préférences restent dans les réglages des plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige funciones de plugins activos. Sus preferencias se gestionan en los ajustes del plugin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha funções dos plugins ativos. As preferências ficam nas definições dos plugins."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите функции включённых плагинов. Параметры остаются в настройках плагинов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin eklentilerin özelliklerini seçin. Tercihler eklenti ayarlarında kalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ميزات الملحقات المفعلة. تبقى تفضيلاتها في إعدادات الملحقات."
          }
        }
      }
    },
