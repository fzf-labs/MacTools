    "launcher.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings > Privacy & Security > Accessibility, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请前往系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往系統設定 → 隱私權與安全性 → 輔助使用，允許 MacTools 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定のプライバシーとセキュリティ → アクセシビリティでMacToolsを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen erlauben und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système > Confidentialité et sécurité > Accessibilité, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad y reintenta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema > Privacidade e Segurança > Acessibilidade e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках > Конфиденциальность и безопасность > Универсальный доступ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Erişilebilirlik bölümünde MacTools’a izin verip yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام > الخصوصية والأمان > تسهيلات الاستخدام، ثم أعد المحاولة."
          }
        }
      }
    },
