    "Changes could not be saved. Check available disk space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes could not be saved. Check available disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存更改，请检查磁盘空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存變更，請檢查磁碟空間。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen konnten nicht gesichert werden. Speicherplatz prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer. Vérifiez l’espace disque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los cambios. Revisa el espacio en disco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Verifique o espaço em disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できません。ディスクの空き容量を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경사항을 저장할 수 없습니다. 디스크 공간을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изменения. Проверьте место на диске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler kaydedilemedi. Disk alanını kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ التغييرات. تحقق من مساحة القرص."
          }
        }
      }
    },
    "Choose a folder or browse Wallhaven.": {
      "localizations": {
        "en": {
