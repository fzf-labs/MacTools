        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 및 온라인 배경화면을 찾아보고 변경합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр и смена локальных и онлайн-обоев."
