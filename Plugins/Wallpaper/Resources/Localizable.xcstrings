    "Browse and rotate local and online wallpapers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and rotate local and online wallpapers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览本地与在线壁纸，按需自动轮换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽本機與線上桌布，依需要自動輪換。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale und Online-Hintergründe durchsuchen und wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez et alternez les fonds locaux et en ligne."
