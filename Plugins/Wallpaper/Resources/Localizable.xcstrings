    "Images are downloaded directly from Wallhaven. SFW content only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images are downloaded directly from Wallhaven. SFW content only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片直接从 Wallhaven 下载，仅显示普通内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片直接從 Wallhaven 下載，僅顯示一般內容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden direkt von Wallhaven geladen. Nur SFW-Inhalte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images téléchargées directement depuis Wallhaven. Contenu SFW uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes se descargan de Wallhaven. Solo contenido SFW."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens baixadas diretamente do Wallhaven. Apenas conteúdo SFW."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は Wallhaven から直接ダウンロードされます。SFW のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 Wallhaven에서 직접 다운로드합니다. SFW 콘텐츠만 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения загружаются с Wallhaven. Только SFW."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüler doğrudan Wallhaven’dan indirilir. Yalnızca SFW içerik."
          }
        },
        "ar": {
          "stringUnit": {
