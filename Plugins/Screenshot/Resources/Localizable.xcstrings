    "record.pointerMonitorUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer activity is unavailable. Try again or turn off Auto Zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取鼠标操作，请重试或关闭自动缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取滑鼠操作，請重試或關閉自動縮放"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قراءة نشاط المؤشر. أعد المحاولة أو أوقف التكبير التلقائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigeraktivität ist nicht verfügbar. Versuche es erneut oder deaktiviere den automatischen Zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad del puntero no está disponible. Inténtalo de nuevo o desactiva el zoom automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité du pointeur est indisponible. Réessayez ou désactivez le zoom automatique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの操作を読み取れません。もう一度試すか、自動ズームをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 활동을 읽을 수 없습니다. 다시 시도하거나 자동 확대/축소를 끄세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A atividade do ponteiro não está disponível. Tente novamente ou desative o zoom automático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся получить действия указателя. Повторите попытку или отключите автомасштаб."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçi etkinliği okunamıyor. Yeniden deneyin veya Otomatik Yakınlaştırma'yı kapatın."
          }
        }
      }
    },
