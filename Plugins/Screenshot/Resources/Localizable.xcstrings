    "scroll.compositionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not assemble the scrolling screenshot; try a smaller capture area"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmalı ekran görüntüsü birleştirilemedi; daha küçük bir yakalama alanı deneyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法合成长截图，请缩小截图范围后重试"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تجميع لقطة الشاشة بالتمرير؛ جرّب منطقة التقاط أصغر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll-Screenshot konnte nicht zusammengesetzt werden; kleineren Aufnahmebereich versuchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ensamblar la captura de pantalla con desplazamiento; prueba con un área de captura más pequeña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'assembler la capture d'écran défilante ; essayez une zone de capture plus petite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールスクリーンショットを合成できませんでした。キャプチャ範囲を小さくして再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 스크린샷을 조합할 수 없습니다. 더 작은 캡처 영역을 사용해 보세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível montar a captura de tela de rolagem; tente uma área de captura menor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось собрать скриншот с прокруткой; попробуйте меньшую область захвата"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法合成長截圖，請縮小截圖範圍後重試"
          }
        }
      }
    },
