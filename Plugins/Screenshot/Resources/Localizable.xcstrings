    "settings.shortcuts.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign global shortcuts for common actions. None are assigned by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置常用功能的全局快捷键，默认不绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定常用功能的全域快速鍵，預設不綁定。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن اختصارات عامة للإجراءات الشائعة. لا يتم تعيين أي منها افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globale Kurzbefehle für häufige Aktionen festlegen. Standardmäßig nicht belegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna atajos globales a las acciones habituales. Sin asignar de forma predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez des raccourcis globaux aux actions courantes. Aucun par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う機能のグローバルショートカットを設定します。初期状態では未設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 기능의 전역 단축키를 설정합니다. 기본값은 미지정입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina atalhos globais para ações frequentes. Nenhum é atribuído por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте глобальные сочетания для частых действий. По умолчанию не назначены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullanılan işlemler için genel kestirmeler atayın. Varsayılan olarak atanmamıştır."
          }
        }
      }
    },
