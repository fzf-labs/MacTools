    "settings.autoZoom.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available for region and display recordings. Zooms toward clicks or scrolling, then returns to the full view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅区域和显示器录制可用。点击或滚动时放大该位置，随后恢复全景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅區域和顯示器錄製可用。點擊或捲動時放大該位置，隨後恢復全景。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح لتسجيل المنطقة والشاشة. يكبّر موضع النقر أو التمرير، ثم يعود إلى العرض الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Bereichs- und Bildschirmaufnahmen. Vergrößert Klick- oder Scrollpositionen und kehrt dann zur Gesamtansicht zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible al grabar áreas y pantallas. Amplía donde haces clic o desplazas y vuelve a la vista completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible pour les zones et écrans. Zoome vers les clics ou le défilement, puis rétablit la vue complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲・ディスプレイ収録で利用できます。クリックやスクロール位置を拡大し、その後全体表示に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역 및 디스플레이 녹화에서 사용할 수 있습니다. 클릭하거나 스크롤한 위치를 확대한 후 전체 화면으로 돌아갑니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível para gravações de áreas e telas. Amplia cliques ou rolagem e depois retorna à visão completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно при записи области или дисплея. Приближает место щелчка или прокрутки, затем возвращает общий вид."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölge ve ekran kayıtlarında kullanılabilir. Tıklama veya kaydırma konumuna yakınlaşıp tam görünüme döner."
          }
        }
      }
    },
