    "settings.output.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture copies to the clipboard; screenshots can be saved as PNG, and recordings save automatically as MOV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速截图复制到剪贴板；截图可保存为 PNG，录屏自动保存为 MOV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速截圖複製到剪貼簿；截圖可儲存為 PNG，錄製自動儲存為 MOV。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسخ اللقطة السريعة إلى الحافظة؛ يمكن حفظ اللقطات بصيغة PNG وتُحفظ التسجيلات تلقائيًا بصيغة MOV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellaufnahme kopiert in die Zwischenablage; Screenshots als PNG speichern, Aufnahmen werden automatisch als MOV gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura rápida copia al portapapeles; las capturas se guardan como PNG y las grabaciones automáticamente como MOV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture rapide copie dans le presse-papiers ; les captures peuvent être enregistrées en PNG, les vidéos sont enregistrées automatiquement en MOV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック撮影はクリップボードにコピーします。画像は PNG で保存でき、収録は MOV で自動保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 캡처는 클립보드에 복사합니다. 스크린샷은 PNG로 저장할 수 있으며 녹화는 MOV로 자동 저장합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura rápida copia para a área de transferência; capturas podem ser salvas como PNG e gravações são salvas automaticamente como MOV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый снимок копируется в буфер обмена; снимки можно сохранить в PNG, записи автоматически сохраняются в MOV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Yakalama panoya kopyalar; görüntüler PNG olarak kaydedilebilir, kayıtlar otomatik olarak MOV kaydedilir."
          }
        }
      }
    },
