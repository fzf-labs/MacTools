      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد منطقة لنسخها فورًا إلى الحافظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereich auswählen und sofort in die Zwischenablage kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a region and immediately copy it to the clipboard."
          }
        },
        "es": {
