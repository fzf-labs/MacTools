    "pin.created": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned on screen; double-click or press Esc to close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrana sabitlendi; kapatmak için çift tıklayın veya Esc tuşuna basın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已钉在屏幕上，双击或 Esc 关闭"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبت على الشاشة؛ انقر نقرًا مزدوجًا أو اضغط على Esc للإغلاق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Bildschirm fixiert; zum Schließen doppelklicken oder Esc drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijado en la pantalla; haga doble clic o presione Esc para cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglé à l’écran ; double-cliquez ou appuyez sur Échap pour fermer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に固定されています。ダブルクリックするか、Esc キーを押して閉じます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 고정되어 있습니다. 두 번 클릭하거나 Esc를 눌러 닫습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixado na tela; clique duas vezes ou pressione Esc para fechar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплено на экране; дважды щелкните или нажмите Esc, чтобы закрыть"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已釘選在螢幕上，按兩下或按 Esc 關閉"
          }
        }
      }
    },
    "pin.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move · Scroll to zoom · Double-click/Esc to close · ⌘C to copy · ⌘S to save"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak için sürükleyin · Yakınlaştırmak için kaydırın · Kapatmak için çift tıklayın/Esc · Kopyalamak için ⌘C · Kaydetmek için ⌘S"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动移动 · 滚轮缩放 · 双击/Esc 关闭 · ⌘C 复制 · ⌘S 保存"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للنقل · مرّر للتكبير والتصغير · انقر نقرًا مزدوجًا/Esc للإغلاق · ⌘C للنسخ · ⌘S للحفظ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Verschieben · Scrollen zum Zoomen · Doppelklick/Esc zum Schließen · ⌘C zum Kopieren · ⌘S zum Speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastrar para mover · Desplazarse para hacer zoom · Doble clic/Esc para cerrar · ⌘C para copiar · ⌘S para guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer · Faites défiler pour zoomer · Double-cliquez/Échap pour fermer · ⌘C pour copier · ⌘S pour enregistrer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして移動 · スクロールしてズーム · ダブルクリック/Esc で閉じる · ⌘C でコピー · ⌘S で保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 이동 · 확대/축소하려면 스크롤 · 닫으려면 두 번 클릭/Esc · 복사하려면 ⌘C · 저장하려면 ⌘S"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover · Role para ampliar · Clique duas vezes/Esc para fechar · ⌘C para copiar · ⌘S para salvar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы переместить · Прокрутите, чтобы увеличить · Дважды щелкните/Esc, чтобы закрыть · ⌘C, чтобы скопировать · ⌘S, чтобы сохранить"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以移動 · 捲動以縮放 · 按兩下或按 Esc 關閉 · ⌘C 複製 · ⌘S 儲存"
          }
        }
      }
    },
