    "settings.recording.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with the recording toolbar. Changes during recording apply next time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与录屏工具栏同步；录制中的更改将在下次生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與錄製工具列同步；錄製中的更改將於下次生效。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشترك مع شريط أدوات التسجيل. تسري التغييرات أثناء التسجيل في المرة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Aufnahmeleiste synchronisiert. Änderungen während der Aufnahme gelten beim nächsten Mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza con la barra de grabación. Los cambios durante la grabación se aplican la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisé avec la barre d’enregistrement. Les modifications en cours d’enregistrement s’appliquent au suivant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収録ツールバーと共通です。収録中の変更は次回から反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화 도구 막대와 동기화합니다. 녹화 중 변경 사항은 다음 녹화에 적용됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhado com a barra de gravação. Alterações durante a gravação valem na próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие настройки с панелью записи. Изменения во время записи применятся в следующий раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt araç çubuğuyla ortaktır. Kayıt sırasındaki değişiklikler bir sonraki kayda uygulanır."
          }
        }
      }
    },
