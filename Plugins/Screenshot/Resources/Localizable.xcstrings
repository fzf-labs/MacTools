    "permission.screenRecording.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required for screenshots and screen recordings. Images and recognized content are processed on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri ve ekran kayıtları için gereklidir. Görseller ve tanınan içerik bu Mac'te işlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于截取屏幕内容和录屏，图像与识别结果仅在本机处理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب لالتقاط لقطات الشاشة وتسجيل الشاشة. تُعالج الصور والمحتوى المتعرّف عليه على جهاز Mac هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich für Screenshots und Bildschirmaufnahmen. Bilder und erkannte Inhalte werden auf diesem Mac verarbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para capturar y grabar la pantalla. Las imágenes y el contenido reconocido se procesan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis pour les captures d'écran et les enregistrements d'écran. Les images et le contenu reconnu sont traités sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットと画面録画に必要です。画像と認識されたコンテンツはこの Mac で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린샷 및 화면 녹화에 필요합니다. 이미지와 인식된 콘텐츠는 이 Mac에서 처리됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para capturas e gravações de tela. Imagens e conteúdo reconhecido são processados neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется для снимков экрана и записей экрана. Изображения и распознанный контент обрабатываются на этом Mac."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於截取螢幕內容和螢幕錄影，圖像與辨識結果僅在本機處理。"
          }
        }
      }
    },
    "permission.screenRecording.guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings → Privacy & Security → Screen & System Audio Recording (or Screen Recording)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Ekran Kaydı bölümünde MacTools'a izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 录屏与系统录音（或录屏）中授权 MacTools。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح MacTools الإذن في إعدادات النظام ← الخصوصية والأمن ← تسجيل الشاشة وصوت النظام (أو تسجيل الشاشة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacTools unter Systemeinstellungen → Datenschutz & Sicherheit → Aufnahme von Bildschirm & Systemaudio (oder Bildschirmaufnahme) zulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza a MacTools en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla y del audio del sistema (o Grabación de pantalla)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et des sons du système (ou Enregistrement de l’écran)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → 画面収録とシステムオーディオ録音（または画面収録）で MacTools を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 화면 및 시스템 오디오 녹음(또는 화면 기록)에서 MacTools를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize o MacTools em Ajustes do Sistema → Privacidade e Segurança → Gravação do Áudio do Sistema e da Tela (ou Gravação de Tela)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ для MacTools в Системных настройках → Конфиденциальность и безопасность → Запись экрана и системного звука (или Запись экрана)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→「隱私權與安全性」→「螢幕與系統錄音」（或「螢幕錄影」）中授權 MacTools。"
          }
        }
      }
    },
    "permission.screenRecording.title": {
      "extractionState": "manual",
