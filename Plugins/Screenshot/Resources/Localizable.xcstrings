    "action.record.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a target and audio, then start. Invoke again while recording to stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择录制目标和声音后开始；录制中再次按下停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇錄製目標和聲音後開始；錄製中再次按下停止。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الهدف والصوت، ثم ابدأ. نفّذ مرة أخرى أثناء التسجيل لإيقافه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel und Audio wählen, dann starten. Während der Aufnahme erneut ausführen, um zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige destino y audio e inicia. Vuelve a ejecutar durante la grabación para detenerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la cible et le son, puis démarrez. Réexécutez pendant l’enregistrement pour arrêter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象と音声を選んで開始します。収録中にもう一度実行すると停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상과 오디오를 선택한 후 시작합니다. 녹화 중 다시 실행하면 중지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o alvo e o áudio e inicie. Execute novamente durante a gravação para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите источник и звук, затем начните. Повторный вызов во время записи остановит её."
