    "record.audio.hostUpdate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update MacTools to enable audio recording. Silent recording is still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本的 MacTools 不支持录音，请更新主程序后使用。仍可无声录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前版本的 MacTools 不支援錄音，請更新主程式。仍可無聲錄製。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث MacTools لتمكين تسجيل الصوت. لا يزال التسجيل الصامت متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere MacTools für Audioaufnahmen. Stumme Aufnahmen bleiben verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza MacTools para grabar audio. Puedes seguir grabando sin sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez MacTools à jour pour enregistrer l’audio. L’enregistrement muet reste disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声収録には MacTools の更新が必要です。無音収録は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 녹화를 사용하려면 MacTools를 업데이트하세요. 무음 녹화는 계속 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o MacTools para gravar áudio. A gravação sem som continua disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите MacTools для записи звука. Запись без звука по-прежнему доступна."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kaydı için MacTools’u güncelleyin. Sessiz kayıt kullanılabilir."
          }
        }
      }
    },
    "record.target.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording target is closed or unavailable. Select it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制目标已关闭或不可用，请重新选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製目標已關閉或無法使用，請重新選擇"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف التسجيل مغلق أو غير متاح. حدده مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufnahmeziel ist geschlossen oder nicht verfügbar. Wähle es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino está cerrado o no disponible. Vuelve a seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cible est fermée ou indisponible. Sélectionnez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収録対象が閉じられたか利用できません。選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화 대상이 닫혔거나 사용할 수 없습니다. 다시 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O destino está fechado ou indisponível. Selecione-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект записи закрыт или недоступен. Выберите его заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt hedefi kapalı veya kullanılamıyor. Yeniden seçin."
          }
        }
      }
    },
    "record.microphone.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings → Privacy & Security → Microphone, or turn off microphone recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 麦克风中允许 MacTools 访问，或关闭麦克风录制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 隱私權與安全性 → 麥克風中允許 MacTools 存取，或關閉麥克風錄製"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام ← الخصوصية والأمان ← الميكروفون، أو عطّل تسجيل الميكروفون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube MacTools unter Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon oder deaktiviere die Mikrofonaufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema → Privacidad y seguridad → Micrófono, o desactiva el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système → Confidentialité et sécurité → Microphone, ou désactivez le micro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → マイクで MacTools を許可するか、マイク収録をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 마이크에서 MacTools를 허용하거나 마이크 녹음을 끄세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Definições do Sistema → Privacidade e Segurança → Microfone, ou desligue a gravação do microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools доступ в Системных настройках → Конфиденциальность и безопасность → Микрофон или отключите запись микрофона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Mikrofon bölümünde MacTools’a izin verin veya mikrofon kaydını kapatın."
          }
        }
      }
    },
    "record.microphone.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected microphone disconnected. Select an input again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选麦克风已断开，请重新选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選麥克風已中斷連線，請重新選擇"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع اتصال الميكروفون المحدد. حدد إدخالًا مجددًا."
