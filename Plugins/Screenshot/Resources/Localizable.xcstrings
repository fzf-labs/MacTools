{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "capture.invalidRegion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture region is invalid. Select it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama alanı geçersiz. Yeniden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图区域无效，请重新选择"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منطقة الالتقاط غير صالحة. حددها مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufnahmebereich ist ungültig. Wählen Sie ihn erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región de captura no es válida. Selecciónala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone de capture n’est pas valide. Sélectionnez-la à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ領域が無効です。もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 영역이 잘못되었습니다. 다시 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A região de captura é inválida. Selecione-a novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимая область захвата. Выберите ее еще раз."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖區域無效，請重新選擇"
          }
        }
      }
    },
