    "sensors.help" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Highest reading in each component; power comes from hardware energy counters." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "温度取组件内最高读数，功耗来自硬件能耗计数器。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "溫度取元件內最高讀數，功耗來自硬體能耗計數器。" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "温度は各コンポーネントの最高値、電力はハードウェアのエネルギーカウンターから取得します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "온도는 구성 요소의 최고 판독값이며 전력은 하드웨어 에너지 카운터에서 가져옵니다." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Höchster Messwert der Komponente; Leistung aus den Hardware-Energiezählern." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Valeur maximale du composant ; puissance issue des compteurs d'énergie matériels." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Lectura más alta del componente; potencia de los contadores de energía del hardware." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Leitura mais alta do componente; potência dos contadores de energia do hardware." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Максимальное значение компонента; мощность из аппаратных счётчиков энергии." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bileşendeki en yüksek değer; güç donanım enerji sayaçlarından alınır." } },
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعلى قراءة في المكوّن؛ والطاقة من عدّادات طاقة العتاد." } }
      }
    },
