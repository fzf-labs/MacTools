    "category.virtualization.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتأثر أقراص الأجهزة الافتراضية، لكن يجب إعادة إنشاء الذاكرة المؤقتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VM-Festplatten bleiben erhalten; Snapshot-Caches und temporäre Dateien werden neu erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machine disks are unaffected; snapshot caches and temporary files must be rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los discos virtuales no cambian; se regenerarán las cachés y archivos temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques virtuels restent intacts ; caches et fichiers temporaires seront recréés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシンのディスクには影響せず、キャッシュと一時ファイルは再作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 머신 디스크는 유지되며 캐시와 임시 파일을 다시 만들어야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os discos virtuais não são afetados; caches e ficheiros temporários serão recriados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски виртуальных машин не изменятся; кэши и временные файлы создадутся заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal makine diskleri etkilenmez; anlık görüntü önbelleklerinin ve geçici dosyaların yeniden oluşturulması gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟机磁盘不受影响，快照缓存与临时文件需要重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬機磁碟不受影響，快取與暫存檔需重建。"
          }
        }
      }
    },
