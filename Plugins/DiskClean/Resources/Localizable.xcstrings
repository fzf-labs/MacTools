    "category.cloudOffice.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعيد التطبيقات بناء الذاكرة المحلية، وقد تتباطأ المزامنة مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud- und Büro-Apps bauen lokale Caches neu auf; die Synchronisierung kann kurz langsamer sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud and office apps must rebuild local caches; syncing may slow briefly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps reconstruirán sus cachés locales; la sincronización puede ralentizarse un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps recréeront leurs caches locaux ; la synchronisation peut ralentir brièvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルキャッシュが再構築され、一時的に同期が遅くなる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
