    "category.aiTools.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتأثر المحادثات، لكن يجب إعادة تخزين النماذج وموارد الواجهة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen bleiben erhalten; Modelle und Oberflächenressourcen werden neu zwischengespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations are unaffected; models and interface resources must be cached again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones no cambian; los modelos y recursos de interfaz volverán a almacenarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations restent intactes ; modèles et ressources seront remis en cache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話履歴には影響せず、モデルと画面リソースは再キャッシュが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 기록은 유지되며 모델과 인터페이스 리소스를 다시 캐시해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas não são afetadas; modelos e recursos da interface serão guardados novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История разговоров не изменится; модели и ресурсы будут кэшированы заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmalar etkilenmez; modellerin ve arayüz kaynaklarının yeniden önbelleğe alınması gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话记录不受影响，模型与界面资源需要重新缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話記錄不受影響，模型與介面資源需重新快取。"
          }
        }
      }
    },
