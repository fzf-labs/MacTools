        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한을 허용한 뒤 MacTools를 종료했다가 다시 여세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de conceder o acesso, saia e reabra o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выдачи доступа выйдите из MacTools и откройте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim verdikten sonra MacTools'tan çıkıp yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
