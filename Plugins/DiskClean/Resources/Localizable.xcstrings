    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الذاكرة المؤقتة وملفات التثبيت ومخرجات المشاريع، وأزل التطبيقات وافحص البقايا المحتملة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, Installer und Projektartefakte prüfen, Apps deinstallieren und mögliche Reste untersuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review caches, installers, and project artifacts; uninstall apps and inspect suspected leftovers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cachés, instaladores y archivos generados, desinstala apps y busca posibles restos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier caches, installateurs et fichiers générés, désinstaller des apps et rechercher les résidus présumés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、インストーラ、生成物を整理し、アプリのアンインストールと残留データ候補の確認を行います"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 설치 파일, 빌드 산출물을 정리하고 앱 제거와 잔여 데이터 후보를 확인합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja caches, instaladores e artefactos, desinstale aplicações e procure possíveis resíduos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка кэша, установщиков и артефактов, удаление приложений и поиск возможных остатков"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekleri, yükleyicileri ve proje çıktılarını inceleyin; uygulamaları kaldırın ve olası kalıntıları kontrol edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理缓存、安装包和项目产物，卸载应用并检查疑似残留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理快取、安裝檔和專案產物，解除安裝應用程式並檢查疑似殘留"
          }
        }
      }
    },
