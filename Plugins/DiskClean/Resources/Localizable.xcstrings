    "category.browsers.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يبطؤ فتح المواقع أول مرة، ولا تتأثر الإشارات أو جلسات الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites können einmal langsamer laden; Lesezeichen und Anmeldungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites may load more slowly once; bookmarks and sign-ins are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sitios pueden cargar más despacio una vez; marcadores y sesiones no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sites peuvent charger plus lentement une fois ; favoris et connexions restent intacts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイトの初回表示が遅くなる場合があります。ブックマークとログインには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트의 첫 로딩이 느려질 수 있지만 북마크와 로그인은 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sites podem carregar mais lentamente uma vez; favoritos e sessões não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое открытие сайтов может быть медленнее; закладки и входы не изменятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siteler ilk açılışta bir kez yavaş yüklenebilir; yer imleri ve oturum açma bilgileri etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次访问网站会稍慢，书签与登录状态不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
