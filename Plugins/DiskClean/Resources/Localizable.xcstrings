    "category.appCaches.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يبطؤ الفتح الأول، ويجب إعادة إنشاء الصور المصغرة والمعاينات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Öffnen kann langsamer sein; Miniaturen und Vorschauen werden neu erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may open more slowly once; thumbnails and previews must be regenerated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps pueden abrirse más despacio una vez; se regenerarán miniaturas y vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps peuvent s’ouvrir plus lentement une fois ; miniatures et aperçus seront recréés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動が遅くなり、サムネールとプレビューが再生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실행이 느려지고 축소판과 미리 보기를 다시 생성해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira abertura pode ser mais lenta; miniaturas e pré-visualizações serão recriadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое открытие может быть медленнее; миниатюры будут созданы заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar ilk açılışta bir kez yavaş açılabilir; küçük resimlerin ve önizlemelerin yeniden oluşturulması gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关应用首次打开会稍慢，缩略图与预览需要重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關 App 首次開啟可能較慢，縮圖與預覽需重新產生。"
          }
        }
      }
    },
