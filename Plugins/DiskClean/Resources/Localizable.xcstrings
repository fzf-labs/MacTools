          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force quitting may lose unsaved changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar la salida puede perder los cambios sin guardar."
          }
        },
