    "detail.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف النهائي يتجاوز سلة المهملات ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültiges Löschen umgeht den Papierkorb und kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanent deletion skips the Trash and can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación permanente no usa la Papelera y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression définitive n’utilise pas la corbeille et est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全削除はゴミ箱を経由せず、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 삭제는 휴지통을 거치지 않으며 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão permanente não passa pelo Lixo e não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратное удаление минует Корзину и не отменяется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı silme, öğeleri Çöp'e atmadan doğrudan siler ve geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除不进废纸篓，无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除不進廢紙簍，無法恢復。"
