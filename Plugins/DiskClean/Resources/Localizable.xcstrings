{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "applications.admin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم وصول المسؤول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorrechte erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator access required"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requieren permisos de administrador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Droits administrateur requis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限が必要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한 필요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer acesso de administrador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны права администратора"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici erişimi gerekli"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理员权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要管理員權限"
          }
        }
      }
    },
    "applications.cancel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
