    "category.systemCaches.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تستعيد التطبيقات نوافذها، ويجب إعادة إنشاء صور المعاينة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps stellen Fenster möglicherweise nicht wieder her; Vorschaubilder werden neu erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may not restore previous windows; preview thumbnails must be rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que las apps no restauren sus ventanas; se regenerarán las miniaturas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps peuvent ne pas restaurer leurs fenêtres ; les vignettes seront recréées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のウインドウが復元されず、プレビューが再作成される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 창이 복원되지 않을 수 있으며 미리 보기 축소판을 다시 만들어야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações podem não restaurar janelas; as miniaturas serão recriadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна могут не восстановиться; миниатюры будут созданы заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar önceki pencerelerini geri yüklemeyebilir; önizleme küçük resimlerinin yeniden oluşturulması gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开应用可能不恢复上次的窗口，预览缩略图需要重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 可能不會還原視窗，預覽縮圖需重建。"
          }
        }
      }
    },
