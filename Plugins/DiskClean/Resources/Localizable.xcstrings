    "category.applications.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنقل التطبيقات إلى المهملات؛ وتُحفظ البيانات الشخصية افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps werden in den Papierkorb bewegt; persönliche Daten bleiben standardmäßig erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps move to Trash; personal data is kept by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps van a la Papelera; los datos personales se conservan por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps vont à la corbeille ; les données personnelles sont conservées par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをゴミ箱に移し、個人データは既定で保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 휴지통으로 이동하며 개인 데이터는 기본적으로 유지됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações vão para o Lixo; os dados pessoais são mantidos por predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения перемещаются в Корзину; личные данные сохраняются по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar Çöp Sepeti’ne taşınır; kişisel veriler varsayılan olarak korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用将移到废纸篓，个人数据默认保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式將移到垃圾桶，個人資料預設保留。"
          }
        }
      }
    },
