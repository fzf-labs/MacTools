    "explanation.logs.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفقد السجلات السابقة ومعلومات التشخيص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisherige Protokolle und Diagnoseaufzeichnungen gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical logs and diagnostic records will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los registros históricos y de diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens journaux et les données de diagnostic seront perdus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去のログと診断記録が失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 로그와 진단 기록이 사라집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registos históricos e de diagnóstico serão perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История журналов и диагностические записи будут потеряны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş günlükler ve tanılama kayıtları kaybolacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史日志和诊断记录将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史日誌和診斷記錄將遺失。"
          }
        }
      }
    },
    "explanation.logs.regeneration": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنشئ التطبيقات سجلات جديدة؛ ولا يمكن إعادة إنشاء السجل المحذوف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erstellen neue Protokolle; gelöschte Einträge lassen sich nicht neu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps create new logs; deleted history cannot be regenerated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aplicaciones crean nuevos registros; el historial eliminado no puede regenerarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps créent de nouveaux journaux ; l’historique supprimé ne peut pas être régénéré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは新しいログを生成しますが、削除された履歴は再生成できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 새 로그를 생성하지만 삭제된 기록은 다시 생성할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações criam novos registos; o histórico eliminado não pode ser regenerado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения создают новые журналы; удалённую историю невозможно создать заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar yeni günlükler oluşturur; silinen geçmiş geri getirilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会生成新日志，已删除的历史记录无法重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會產生新日誌，已刪除的歷史記錄無法重建。"
          }
        }
      }
    },
    "explanation.logs.whyMatched": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات التطبيقات والسجلات السابقة الناتجة عن التدوير في ~/Library/Logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Protokolle und rotierte Protokolle unter ~/Library/Logs."
          }
