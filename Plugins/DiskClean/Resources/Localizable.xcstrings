    "explanation.cache.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تحتاج التطبيقات إلى تنزيل المحتوى مجددًا أو إعادة إنشاء المعاينات عند فتحها في المرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Öffnen müssen Apps möglicherweise Inhalte erneut laden oder Vorschauen neu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may download content again or rebuild previews when next opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrirlas de nuevo, las aplicaciones podrían tener que descargar contenido o regenerar las vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À leur prochaine ouverture, les apps devront peut-être télécharger à nouveau du contenu ou régénérer les aperçus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回アプリを開くときに、コンテンツの再ダウンロードやプレビューの再生成が必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열 때 콘텐츠를 다시 다운로드하거나 미리보기를 재생성해야 할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir novamente as aplicações, poderá ser necessário voltar a descarregar conteúdo ou gerar pré-visualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующем открытии приложениям может потребоваться повторная загрузка содержимого или создание миниатюр."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar bir dahaki açılışta içeriği yeniden indirebilir ya da önizlemeleri yeniden oluşturabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开应用时，可能需要重新下载内容或生成预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次開啟 App 時，可能需要重新下載內容或產生預覽。"
          }
        }
      }
    },
    "explanation.cache.regeneration": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد التطبيقات إنشاء ذاكرات التخزين المؤقت اللازمة عند فتحها في المرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erstellen benötigte Caches beim nächsten Öffnen neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps rebuild necessary caches when next opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aplicaciones regeneran las cachés necesarias al abrirlas de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps régénèrent les caches nécessaires à leur prochaine ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回アプリを開くときに、必要なキャッシュが再生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열 때 필요한 캐시가 다시 생성됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações regeneram as caches necessárias quando são abertas novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующем открытии приложения заново создадут необходимые кэши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar bir dahaki açılışta gerekli önbellekleri yeniden oluşturur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用下次打开时会重新生成所需缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 下次開啟時會重新產生所需快取。"
          }
        }
      }
    },
