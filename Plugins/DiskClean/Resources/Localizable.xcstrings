    },
    "applications.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد نقل العناصر المحددة إلى سلة المهملات؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Objekte in den Papierkorb bewegen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move selected items to Trash?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Mover los elementos seleccionados a la Papelera?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les éléments sélectionnés à la corbeille ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目をゴミ箱に移しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 휴지통으로 옮기겠습니까?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover os itens selecionados para o Lixo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить выбранные объекты в Корзину?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili öğeler Çöp Sepeti’ne taşınsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选项目移到废纸篓？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所選項目移到垃圾桶？"
          }
        }
      }
    },
    "applications.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عناصر للمراجعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Objekte zum Prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No items to review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay elementos para revisar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément à vérifier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する項目はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토할 항목이 없습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem itens para rever"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет объектов для проверки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenecek öğe yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现可审阅的项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未發現可檢閱的項目"
          }
        }
      }
    },
    "applications.expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية النتائج. أعد الفحص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse abgelaufen. Erneut scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results expired. Scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados han caducado. Analiza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats expirés. Relancez l’analyse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果の有効期限が切れました。再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 만료되었습니다. 다시 스캔하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados expiraram. Analise novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты устарели. Повторите сканирование."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçların süresi doldu. Yeniden tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果已过期，请重新扫描"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果已過期，請重新掃描"
          }
        }
      }
    },
    "applications.guidance": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ البيانات الشخصية افتراضيًا. أغلق التطبيقات قبل مراجعة العناصر المراد نقلها إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Daten bleiben standardmäßig erhalten. Beende Apps, bevor du die zu löschenden Objekte prüfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal data is kept by default. Quit apps before reviewing items to move to Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos personales se conservan por defecto. Cierra las apps antes de revisar qué mover a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données personnelles sont conservées par défaut. Quittez les apps avant de vérifier les éléments à mettre à la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人データは既定で保持されます。アプリを終了してからゴミ箱に移す項目を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 데이터는 기본적으로 유지됩니다. 앱을 종료한 후 휴지통으로 옮길 항목을 검토하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados pessoais são mantidos por predefinição. Feche as aplicações antes de rever os itens a mover para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные данные сохраняются по умолчанию. Закройте приложения перед проверкой объектов для Корзины."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel veriler varsayılan olarak korunur. Çöp Sepeti’ne taşınacak öğeleri incelemeden önce uygulamaları kapatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人数据默认保留。请先退出应用，再审阅需要移到废纸篓的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人資料預設保留。請先結束應用程式，再檢閱要移到垃圾桶的項目。"
          }
        }
      }
    },
    "applications.leftovers.guidance": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقايا المحتملة لا تثبت إزالة التطبيق. تحقق من مصدرها؛ لا يُحدد أي عنصر افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermutete Reste beweisen keine Deinstallation. Prüfe die Zuordnung; anfangs ist nichts ausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspected leftovers do not prove an app is uninstalled. Check ownership; all items start unselected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los posibles restos no prueban que una app esté desinstalada. Revisa su origen; nada está seleccionado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résidus supposés ne prouvent pas la désinstallation. Vérifiez leur origine ; rien n’est sélectionné par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残存の疑いはアンインストール済みの証明ではありません。所有元を確認してください。既定では何も選択されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔여 데이터로 추정되어도 앱이 제거되었다는 뜻은 아닙니다. 소유 앱을 확인하세요. 기본적으로 아무것도 선택되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os possíveis resíduos não provam que a aplicação foi desinstalada. Confirme a origem; nada é selecionado por predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предполагаемые остатки не доказывают удаление приложения. Проверьте владельца; по умолчанию ничего не выбрано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şüpheli kalıntılar uygulamanın kaldırıldığını kanıtlamaz. Sahibini kontrol edin; başlangıçta hiçbir öğe seçili değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疑似残留不代表应用确定已卸载。请核对归属，所有项目默认不选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "疑似殘留不代表應用程式確定已解除安裝。請核對歸屬，所有項目預設不選。"
          }
        }
      }
    },
