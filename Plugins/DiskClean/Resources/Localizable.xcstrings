    "explanation.mobile.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتطلب البناء التالي تنزيل الاعتماديات مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Build müssen Abhängigkeiten möglicherweise erneut heruntergeladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next build may need to download dependencies again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima compilación podría requerir que se descarguen de nuevo las dependencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine compilation pourra nécessiter un nouveau téléchargement des dépendances."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のビルド時に、依存関係の再ダウンロードが必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 빌드 시 종속성을 다시 다운로드해야 할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima compilação poderá exigir que as dependências sejam descarregadas novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующей сборке может потребоваться повторная загрузка зависимостей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki derlemede bağımlılıkların yeniden indirilmesi gerekebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次构建时可能需要重新下载依赖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次建置時可能需要重新下載依賴項目。"
          }
        }
      }
    },
    "explanation.mobile.regeneration": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي البناء التالي أو تشغيل pod install أو Carthage إلى تنزيل الاعتماديات المطلوبة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Build oder Aufruf von pod install oder Carthage werden benötigte Abhängigkeiten erneut heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next build, pod install, or Carthage command downloads the required dependencies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima compilación o ejecución de pod install o Carthage descargará de nuevo las dependencias necesarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine compilation ou exécution de pod install ou de Carthage téléchargera à nouveau les dépendances nécessaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のビルド、pod install、またはCarthageの実行時に、必要な依存関係が再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 빌드 또는 pod install, Carthage 실행 시 필요한 종속성이 다시 다운로드됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima compilação ou execução de pod install ou Carthage descarregará novamente as dependências necessárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При следующей сборке или запуске pod install либо Carthage необходимые зависимости будут загружены заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki derleme, pod install ya da Carthage komutu gerekli bağımlılıkları indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次构建或运行 pod install、Carthage 时会重新下载所需依赖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次建置或執行 pod install、Carthage 時會重新下載所需依賴項目。"
          }
        }
      }
    },
