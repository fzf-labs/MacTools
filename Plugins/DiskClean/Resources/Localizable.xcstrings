    "category.userEssentials.consequence": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يبطؤ التشغيل الأول، ولا تتأثر جلسات الدخول أو المستندات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Start kann langsamer sein; Anmeldungen und Dokumente bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may launch more slowly once; sign-ins and documents are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer inicio puede ser más lento; las sesiones y los documentos no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier lancement peut être plus lent ; connexions et documents restent intacts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動が遅くなる場合があります。ログイン状態と書類には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실행이 느려질 수 있지만 로그인 상태와 문서는 영향을 받지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira abertura pode ser mais lenta; sessões e documentos não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый запуск может быть медленнее; входы и документы не изменятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar ilk açılışta bir kez yavaş başlayabilir; oturum açma bilgileri ve belgeler etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用首次启动会稍慢，登录状态与文档不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 首次啟動可能較慢，登入狀態與文件不受影響。"
          }
        }
      }
    },
